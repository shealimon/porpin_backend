# Required for translation (worker process)
OPENAI_API_KEY=sk-...

# Optional model (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Chunking (500–1000 tokens per plan)
# CHUNK_MAX_TOKENS=1000
# CHUNK_MIN_TOKENS=500
# TRANSLATE_MAX_CONCURRENCY=5
# Cap concurrent OpenAI chat requests per document (default 3). Lower to 2 if TPM 429s persist.
# TRANSLATE_OPENAI_MAX_INFLIGHT=3

# Max upload size in bytes. Default 0 = no limit (subject to RAM/timeouts). Example cap: 104857600 = 100 MB
# MAX_UPLOAD_BYTES=104857600

# PDF export — themed layout (TOC, headings) uses WeasyPrint + *.structure.json. On bare Ubuntu/EC2
# install OS libs once: sudo bash scripts/install-weasyprint-deps-ubuntu.sh (from this backend/).
# Until then exports fall back to DOCX→PDF (plain-looking). Optional: LibreOffice for better fallback:
# LIBREOFFICE_SOFFICE_PATH=/usr/bin/soffice

# --- Supabase ---
# Project URL (Dashboard → Project Settings → API). Required to verify user access tokens when the
# project uses JWT signing keys (RS256/EC). Must match the host in VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy / HS256 user access tokens: Project Settings → API → JWT Secret (not the anon key).
# If Supabase rotated to asymmetric keys, JWKS + SUPABASE_URL is used; keep secret for local tools if needed.
# SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase PostgreSQL — Dashboard → Connect → Transaction pooler (port 6543)
# Replace postgres:// with postgresql+psycopg2:// in the copied URI; URL-encode special chars in password.
SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Redis + RQ worker queue
# REDIS_URL=redis://127.0.0.1:6379/0

# Run migrations: alembic upgrade head

# JWT for legacy download tokens (if still used)
# JWT_SECRET=use-a-long-random-string-in-production

# Dev: creates API key user + matching profile row
# SEED_API_KEY=dev-your-secret-key

# Stripe (optional; POST /webhooks/stripe)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing (usage rows)
# MINIMUM_CHARGE_INR=5.0
# RATE_INR_PER_10000_WORDS=9.99

# Referrals: bonus trial words for the referrer per new signup; lifetime cap per referrer
# REFERRAL_WORDS_PER_SIGNUP=10000
# REFERRAL_MAX_WORDS_EARNED_PER_REFERRER=100000

# POST /translate: `false` = JSON { job_id } (async queue). `true` = return DOCX/PDF/ZIP in the response body.
# Production: keep false. Local dev (sync /translate page): set ENABLE_SYNC_TRANSLATE=true and restart the API.
ENABLE_SYNC_TRANSLATE=false

# SlowAPI: POST /translate (default 300/min per API key or IP). Raise for prod bursts or use:
# HTTP_TRANSLATE_RATE_LIMIT=2000/minute
# Load testing only (staging): disable limits so 1000+ concurrent requests are not 429:
# HTTP_RATE_LIMIT_ENABLED=false

# Windows + huge concurrency: use Proactor loop (app sets this on import). If you still hit
# "too many file descriptors in select()", use uvicorn --workers 4 or cap concurrent clients.

# Cleanup: delete completed job dirs after N minutes (separate process: python -m app.workers.cleanup_scheduler)
# CLEANUP_TTL_MINUTES=1440

# --- Production (fraud / abuse hardening) ---
# ENVIRONMENT=production
# Required when ENVIRONMENT is production: strong random JWT_SECRET (not the placeholder),
# and ALLOW_ANONYMOUS_JOBS=false (default). Anonymous uploads are blocked in production.
# REQUIRED on EC2 when frontend is https://www.* and API is https://api.* (separate origin).
# Omit this → production uploads fail with Axios "Network Error" (browser CORS blocks POST /upload).
# CORS_ORIGINS=https://www.porpin.com,https://porpin.com
# Optional: reject unexpected Host headers (add LB/internal hosts you use for health checks):
# TRUSTED_HOSTS=api.your-frontend.example.com,127.0.0.1
# Behind nginx/Cloudflare, run uvicorn with: --proxy-headers --forwarded-allow-ips='*' (or your proxy CIDRs)
# --- Razorpay (Standard Checkout + subscriptions + pay-per-job PAYG) ---
# Key secret must stay on the backend only. Frontend (Vite): VITE_RAZORPAY_KEY_ID with the same key id.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Optional webhook: RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_ID=plan_...   # monthly subscription
# RAZORPAY_YEARLY_PLAN_ID=plan_...
# Razorpay live: set keys + RAZORPAY_WEBHOOK_SECRET; payments are signature-verified in code.
# PAYG_CHECKOUT_REQUIRED=true — Pay-as-you-go (PayG): require Razorpay per job before translation (recommended when billing is live).
# Deprecated alias: PAYG_WALLET_REQUIRED (same effect).
# SUPABASE_ALLOW_API_KEY_FALLBACK=false — JWT-only auth (disable raw X-API-Key in production if possible).
# Remove SEED_API_KEY after initial bootstrap; do not ship dev keys to production.
